{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "zh_CN",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "webNavigation", "cookies"],
  "host_permissions": ["*://*.tradingview.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tradingview.com/chart/*"],
      "js": ["src/content/content.ts"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["*://*.tradingview.com/*"],
      "resources": ["inject/page-bridge.js", "inject/main-world.js"],
      "use_dynamic_url": false
    }
  ]
}
